{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pacman",
  "version": "1.2.1",
  "identifier": "com.rachatarath.pacman",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    },
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pac-Man",
        "width": 800,
        "height": 900,
        "minWidth": 480,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A complete, playable Pac-Man clone (Rust WASM + TypeScript).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
